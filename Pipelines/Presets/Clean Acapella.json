{
  "version": 1,
  "name": "Clean Acapella",
  "stages": [
    {
      "id": "vocal_separation",
      "type": "vocal_separation",
      "input": "previous",
      "output": "vocal_separation_out",
      "enabled": true,
      "optional": false,
      "parameters": {
        "wet": 1.0,
        "device": "cuda",
        "stem": "vocals"
      },
      "model": "roformer-model-bs-roformer-leap-xe-vocals-by-pcunwa",
      "engine": "BS"
    },
    {
      "id": "dereverb",
      "type": "dereverb",
      "input": "previous",
      "output": "dereverb_out",
      "enabled": true,
      "optional": false,
      "parameters": {
        "wet": 1.0,
        "device": "cuda",
        "stem": "dry"
      },
      "model": "roformer-model-melband-roformer-de-reverb-super-big-by-sucial",
      "engine": "MEL"
    },
    {
      "id": "deecho",
      "type": "deecho",
      "input": "previous",
      "output": "deecho_out",
      "enabled": false,
      "optional": false,
      "parameters": {
        "wet": 1.0,
        "device": "cuda",
        "stem": "dry"
      },
      "model": "roformer-model-melband-roformer-de-reverb-echo-v2-by-sucial",
      "engine": "MEL"
    },
    {
      "id": "deesser",
      "type": "deesser",
      "input": "previous",
      "output": "deesser_out",
      "enabled": true,
      "optional": false,
      "parameters": {
        "frequency_hz": 5500,
        "threshold_db": -30,
        "max_reduction_db": 6
      },
      "model": null,
      "engine": "DSP"
    },
    {
      "id": "cleanup",
      "type": "cleanup",
      "input": "previous",
      "output": "cleanup_out",
      "enabled": false,
      "optional": false,
      "parameters": {
        "highpass_hz": 65
      },
      "model": null,
      "engine": "DSP"
    },
    {
      "id": "restoration",
      "type": "restoration",
      "input": "previous",
      "output": "restoration_out",
      "enabled": false,
      "optional": false,
      "engine": "ANYENHANCE",
      "model": "anyenhance-v1-baseline",
      "parameters": {
        "wet": 1.0,
        "device": "cuda",
        "timesteps": 20,
        "seed": 42
      }
    },
    {
      "id": "export",
      "type": "export",
      "input": "previous",
      "output": "export_out",
      "enabled": true,
      "optional": false,
      "parameters": {
        "flac": false
      },
      "model": null,
      "engine": "DSP"
    }
  ],
  "info": {
    "de": {
      "short": "Vocal-Trennung mit nachgeschalteter Bearbeitung.",
      "description": "Stimme vom Instrumental trennen (100%) → Hall reduzieren (100%) → Zischlaute reduzieren (5500 Hz, max. 6 dB) → Als WAV exportieren. Stärkere Reinigung kann Höhen oder Details reduzieren.",
      "use_case": "Komplette Songs / Remixe",
      "intensity": "Mittel",
      "models": 2
    },
    "en": {
      "short": "Vocal separation with additional processing.",
      "description": "Separate vocals from the instrumental (100%) → Reduce reverb (100%) → Reduce sibilance (5500 Hz, max. 6 dB) → Export WAV. Stronger cleanup may reduce high frequencies or details.",
